# Скопируй в .env и заполни

# Flask
SECRET_KEY=сгенерируй_случайную_строку

# PostgreSQL (Railway автоматически ставит DATABASE_URL)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Telegram Bot
BOT_TOKEN=123456789:твой_токен_от_BotFather

# Admins — через запятую, Telegram numeric ID (узнать: @userinfobot)
# @zawarkayt и @bread6942 захардкожены по юзернейму, но лучше добавить их ID сюда
ADMIN_TELEGRAM_IDS=123456789,987654321

# Webhook secret (любая случайная строка)
WEBHOOK_SECRET=случайная_строка_32_символа
